# Supabase + Vercel production variables. Do not commit a real .env file.
DATABASE_MODE=supabase
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
DEMO_PASSWORD=DemoPass123!
LOCAL_JWT_SECRET=replace_with_a_long_random_value
GROQ_MOCK=false
GROQ_API_KEY=your_groq_key
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
