# ---- Database ----
# local: standalone Postgres (this repo's tested default, no external accounts needed)
# supabase: point DATABASE_URL at your Supabase Postgres connection string instead,
#           and fill in the SUPABASE_* keys below (see docs/Antigravity_Build_Package.md Section 0)
DATABASE_MODE=local
DATABASE_URL=postgresql+psycopg2://loanapp:loanapp@localhost:5432/loan_copilot

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ---- Auth (local mode only — irrelevant once DATABASE_MODE=supabase) ----
LOCAL_JWT_SECRET=dev-only-change-me

# ---- AI (Groq) ----
# true = offline fixture responses, no network call, fully demoable without a key
# false = calls the real Groq API — requires GROQ_API_KEY
GROQ_MOCK=true
GROQ_API_KEY=
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
AI_RATE_LIMIT_PER_MINUTE=20

# ---- Storage ----
LOCAL_STORAGE_DIR=./storage

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
